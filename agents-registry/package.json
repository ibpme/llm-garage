{
  "name": "agents-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-local Pi and Claude agent registry daemon",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "agents-registry": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsx --test tests/*.test.ts tests/*.test.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": { "ajv": "^8.17.1", "proper-lockfile": "^4.1.2" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/proper-lockfile": "^4.1.4", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}

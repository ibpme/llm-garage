{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistryMessage",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "publish"
        },
        "harness": {
          "enum": [
            "pi",
            "claude"
          ]
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "startedAt": {
              "$ref": "#/$defs/timestamp",
              "description": "Must match the verified process start epoch milliseconds."
            }
          },
          "required": [
            "pid",
            "startedAt"
          ]
        },
        "source": {
          "enum": [
            "pi",
            "claude-hook",
            "claude-statusline"
          ]
        },
        "reportedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "cwd": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "mode": {
                  "enum": [
                    "interactive",
                    "non-interactive",
                    "background",
                    "unknown"
                  ]
                }
              },
              "required": [],
              "minProperties": 1
            },
            "activity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "enum": [
                    "idle",
                    "busy",
                    "waiting",
                    "unknown"
                  ]
                },
                "rawState": {
                  "type": "string",
                  "maxLength": 4096
                },
                "waitingFor": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "required": [
                "state"
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 4096,
                      "minLength": 1
                    },
                    "provider": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "displayName": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "messaging": {
              "anyOf": [
                {
                  "$ref": "#/$defs/messaging"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "version",
        "type",
        "harness",
        "process",
        "source",
        "reportedAt",
        "patch"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "harness": {
                "const": "pi"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "pi"
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "enum": [
                  "claude-hook",
                  "claude-statusline"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "claude-statusline"
              }
            }
          },
          "then": {
            "properties": {
              "patch": {
                "not": {
                  "required": [
                    "activity"
                  ],
                  "type": "object"
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "harness": {
                "const": "claude"
              }
            }
          },
          "then": {
            "properties": {
              "patch": {
                "not": {
                  "required": [
                    "messaging"
                  ],
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "enum": [
            "status",
            "stop"
          ]
        }
      },
      "required": [
        "version",
        "type"
      ]
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "Unix epoch milliseconds",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "path",
        "protocol"
      ],
      "properties": {
        "transport": {
          "const": "unix"
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 100
        },
        "protocol": {
          "const": "pi-listener-v2"
        }
      }
    }
  }
}
